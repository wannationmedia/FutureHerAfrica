# FutureHerAfrica — environment variable names only.
# Copy to .env locally. Never commit secrets.

# ---------------------------------------------------------------------------
# Web application (Prisma)
# Dedicated FutureHer database. Do NOT use wannation_os or WANNATION credentials.
# Create this database only after owner approval of the database boundary.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://futureher_app:<PASSWORD>@localhost:5432/futureher"

# ---------------------------------------------------------------------------
# Production-desk SQL tooling (db/migrate.mjs, db/seed-ep001.mjs)
# Separate from the public application. Leave unset unless running handmade SQL.
# Do not point this at wannation_os for the FutureHer web application.
# ---------------------------------------------------------------------------
# FHA_PRODUCTION_DATABASE_URL="postgresql://futureher_app:<PASSWORD>@localhost:5432/futureher"

# Azure AI Speech (verified partial stack: EN + ZU)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Voice IDs (female only — male voices prohibited)
FHA_VOICE_EN_VOICE_ID=en-ZA-LeahNeural
FHA_VOICE_ZU_VOICE_ID=zu-ZA-ThandoNeural

# Reserved for future verified providers (currently NOT-SUPPORTED)
# FHA_VOICE_NSO_VOICE_ID=
# FHA_VOICE_VE_VOICE_ID=
# FHA_VOICE_TS_VOICE_ID=

# ---------------------------------------------------------------------------
# FutureHer AI / WebMCP
# Server-side only. Never add NEXT_PUBLIC_OPENAI_API_KEY.
# Direct tool invocation works without a model key.
# { message } requires OPENAI_API_KEY; otherwise the API returns PROVIDER_UNAVAILABLE.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# Optional model controls (server-side only; not accepted from the client)
# OPENAI_MODEL=gpt-5.6-terra
# OPENAI_TEMPERATURE=0
# OPENAI_MAX_OUTPUT_TOKENS=512
# OPENAI_TIMEOUT_MS=15000

# Optional runtime limits
# AI_MAX_TOOL_CALLS=1
# AI_MAX_TOOL_INPUT_BYTES=4096
# AI_MAX_RESPONSE_BYTES=8192
# AI_MAX_EXECUTION_DEPTH=1
